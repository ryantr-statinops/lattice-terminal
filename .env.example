# Local Compose data directory. Create it before `docker compose up --build`.
# Windows example: D:/KestrelTerminalData
# macOS/Linux example: /home/your-user/KestrelTerminalData
KESTREL_DATA_DIR=./data
KESTREL_LOCAL_USERNAME=local
# Enter your own password. Single quotes preserve literal special characters.
# Changes take effect after restarting. Never commit .env.
KESTREL_LOCAL_PASSWORD=

# Linux/macOS: set these to the owner IDs of the selected data directory.
# Windows Docker Desktop can keep the defaults.
KESTREL_UID=10001
KESTREL_GID=10001

# Set only after `kestrel -prepare-ssi-compose-secret`; clean it after Compose is down.
# KESTREL_SSI_SECRET_FILE=

# Kestrel reads no SSI credentials from environment files.
