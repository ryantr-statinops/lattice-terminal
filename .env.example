# Application data directory relative to repository root.
KESTREL_DATA_DIR=./data
KESTREL_LOCAL_USERNAME=local
# Enter your own password. Single quotes preserve literal special characters.
# Changes take effect after restarting. Never commit .env.
KESTREL_LOCAL_PASSWORD=

# Required only for the three-terminal debug mode; generate a random local token.
KESTREL_ENGINE_TOKEN=

# Linux/macOS: set these to the owner IDs of the selected data directory.
# Windows Docker Desktop can keep the defaults.
KESTREL_UID=10001
KESTREL_GID=10001

# Set only after `kestrel -prepare-ssi-compose-secret`; clean it after Compose is down.
# KESTREL_SSI_SECRET_FILE=

# Set only after `kestrel -prepare-vault-compose-secret`; clean after Compose is down.
# This path points to a temporary plaintext key file outside the repository.
# KESTREL_VAULT_MASTER_KEY_FILE=

# Kestrel never reads SSI credentials from environment files.
